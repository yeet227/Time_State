[logging]

file_logging/max_log_files=100

[physics]

2d/thread_model=2

[rendering]

threads/thread_model=2
quality/shadow_atlas/quadrant_0_subdiv=3
quality/shadow_atlas/quadrant_1_subdiv=3
quality/shading/force_vertex_shading=true
quality/shading/force_lambert_over_burley=true
quality/shading/force_blinn_over_ggx=true
quality/filters/anisotropic_filter_level=16
quality/subsurface_scattering/quality=2
quality/subsurface_scattering/scale=8
quality/voxel_cone_tracing/high_quality=true
